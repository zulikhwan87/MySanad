# Supabase Configuration (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only key for encrypting MyKad numbers (AES-256-GCM). 32 random bytes, base64.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key makes stored MyKad numbers unreadable; keep a secure backup.
MYSANAD_PII_ENCRYPTION_KEY=

# Optional: shown on the Contact page
NEXT_PUBLIC_CONTACT_EMAIL=
